# ApplyRN environment variables (example, placeholders only)
# Copy values into apps/worker/.dev.vars (local) or Cloudflare Worker secrets (production).
# Never commit real values.

# Telegram bot token from @BotFather. Private.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Chat ID where alerts are delivered. Private.
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Optional: token protecting the dashboard HTTP API when deployed.
# V0 uses a simple shared-secret access layer, not a custom auth product.
DASHBOARD_TOKEN=

# Wrangler / Cloudflare (deploy only, CI gates on presence)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
