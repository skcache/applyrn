# ApplyRN environment variables (example, placeholders only)
# Copy values into apps/worker/.dev.vars (local) or Cloudflare Worker secrets (production).
# Never commit real values.

# Telegram bot token from @BotFather. Private.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Chat ID where alerts are delivered. Private.
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Required: token protecting the dashboard HTTP API. The worker FAILS CLOSED
# without it, so every environment (local .dev.vars and production secret)
# must set the same value.
DASHBOARD_TOKEN=your-dashboard-token

# Wrangler / Cloudflare (deploy only, CI gates on presence)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
